{
  "name": "substrate-texture-designer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Substrate — node-based procedural PBR texture authoring, painting and industry-standard export (Vue 3 + Three.js + Node, zero-bundler ESM).",
  "scripts": {
