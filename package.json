{
  "name": "substrate-texture-designer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Substrate — node-based procedural PBR texture authoring, painting and industry-standard export (Vue 3 + Three.js + Node, zero-bundler ESM).",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build": "node scripts/build.mjs",
    "serve:dist": "node server/index.js --dist",
    "verify": "node scripts/verify-export.mjs",
    "cdp": "node scripts/cdp.mjs",
    "audit": "node scripts/cdp.mjs audit all",
    "audit:quick": "node scripts/cdp.mjs audit schema",
    "audit:ui": "node scripts/cdp.mjs audit ui",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "node scripts/mcp-test.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "audit:mcp": "node scripts/cdp.mjs audit mcp",
    "test:sbsar": "node scripts/test-sbsar.mjs",
    "fixtures:sbsar": "node scripts/make-sbsar-fixture.mjs",
    "bake:sbsar": "node scripts/bake-sbsar.mjs",
    "test:reconstruct": "node scripts/test-reconstruct.mjs"
  },
  "dependencies": {
    "three": "^0.169.0",
    "vue": "^3.5.12"
  },
  "engines": {
    "node": ">=18"
  }
}
